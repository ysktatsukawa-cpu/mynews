<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jutjoy.domain.mapper.ProfileHistoriesMapper">

    <!-- 履歴登録 -->
    <insert id="insert"
            parameterType="com.jutjoy.domain.entity.profile.ProfileHistories"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO profile_histories (
            profile_id,
            edited_date
        )
        VALUES (
            #{profileId},
            CURRENT_TIMESTAMP
        )

    </insert>

</mapper>